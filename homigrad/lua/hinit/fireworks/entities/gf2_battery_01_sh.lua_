-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_battery_01_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_battery_01","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Cold War"
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Batteries"

ENT.Model                            =  "models/models/gf2/rogue_cheney/batteries/battery_01.mdl"                      
ENT.Effect                           =  ""
ENT.EffectAir                        =  ""      
ENT.EffectWater                      =  "water_small"
ENT.ExplosionSound                   =  "physics/wood/wood_crate_break1.wav"
ENT.ArmSound                         =  "physics/wood/wood_box_impact_bullet1.wav"            
ENT.ActivationSound                  =  "physics/wood/wood_box_impact_hard1.wav"     

                 
ENT.Life                             =  25                                 
ENT.MaxDelay                         =  0  
                               
ENT.TraceLength                      =  500
ENT.ImpactSpeed                      =  9000
ENT.Mass                             =  50
ENT.ArmDelay                         =  1
ENT.Timer                            =  0


ENT.GBOWNER                          =  nil             

function ENT:CreatePositions()
	local pos_table = {}
	for x=1,6 do
		for y=1,6 do

			local pos = (self:GetPos()+self:GetUp()*11+self:GetRight()*(11-(3.2*x))+self:GetForward()*(11.2-(3.2*y)))
			table.insert(pos_table, pos)
		end
	end
	return pos_table
end
	
	
function ENT:Start_Launching()
	
	local pos_tbl = self:CreatePositions()
	for k, v in pairs(pos_tbl) do
		timer.Simple(k+math.random(-0.2,0.2), function()
			if !self:IsValid() then return end
			self:GetPhysicsObject():AddVelocity(self:GetUp()*-100+Vector(math.random(-155,155),math.random(-155,155),0))
			local pos_tbl = self:CreatePositions()
			local v = pos_tbl[k]
			self:EmitSound("garrys_fireworks_2/fireworks/battery/battery_shot.wav", 100, math.random(70,120))
			
			local sparky = ents.Create("gf2_battery_pellet")
			sparky:SetPos(v)
			sparky:Spawn()
			sparky.Attacker = self.Attacker
			sparky:Activate()
			sparky.Info = {["Effect"]         = {"gf2_battery_01_explosion_01_2","gf2_battery_01_explosion_02_2","gf2_battery_01_explosion_02","gf2_battery_01_explosion_01"},
						  ["ExplosionSound"] = {"garrys_fireworks_2/fireworks/battery/battery_explode_01.wav", "garrys_fireworks_2/fireworks/battery/battery_explode_02.wav"},
						  ["Trail"]  = table.Random({"gf2_firework_idle_white_trail_2","gf2_firework_idle_golden_trail_2"}),
						  ["ExplosionDelay"] = math.random(0.5,1.5),
						  ["MatchSoundwithEffect"] = true,
						  ["Effect_Sound"]         = {["gf2_battery_01_explosion_01_2"] = "garrys_fireworks_2/fireworks/battery/battery_explode_02.wav", 
													  ["gf2_battery_01_explosion_02_2"] = "garrys_fireworks_2/fireworks/battery/battery_explode_02.wav",
													  ["gf2_battery_01_explosion_02"] = "garrys_fireworks_2/fireworks/battery/battery_explode_01.wav", 
													  ["gf2_battery_01_explosion_01"] = "garrys_fireworks_2/fireworks/battery/battery_explode_01.wav"},
						  }
						  
			sparky:GetPhysicsObject():AddVelocity(Vector(math.random(-550, 550), math.random(-550,1250),0)+(Vector(0,0,100)+5000*self:GetUp()))
			sparky:SetCollisionGroup(COLLISION_GROUP_WORLD)
			

			

			
			ParticleEffect( "gf2_battery_shot_effect", v, self:GetAngles(), self )
		end)
	end
end


function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end


function ENT:Initialize()
	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		if (phys:IsValid()) then
		phys:SetMass(self.Mass)
		phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		
		self:SetSkin(0)
		if !(WireAddon == nil) then self.Inputs   = Wire_CreateInputs(self, { "Ignite"}) end
	end
end





if ( CLIENT ) then
	
	function ENT:Draw()
		self:DrawModel()

		if !(WireAddon == nil) then Wire_Render(self.Entity) end
	end
end

function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end
	 if (iname == "Ignite") then
         if (value >= 1) then
             if (!self.Exploded and !self.Armed and !self.Arming) then
			     self:EmitSound(self.ActivationSound)
                 self:Arm()
             end 
         end
     end		 
end 



function ENT:Explode()
     if !self.Exploded then return end
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
     if self.Exploded then return end
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:Arm()
	if(!self:IsValid()) then return end
	if(self.Exploded) then return end
	if(self.Armed) then return end
	self:EmitSound(self.ArmSound)
	self.Armed=true
	 
	
	timer.Simple(1, function()
		if !self:IsValid() then return end 

		if !self:IsValid() then return end 
		self.HasIgnited = true
		self.HasCalledLaunching = false
		self:Start_Launching()
		self:SetSkin(1)
	end)

end	 
