-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_romancandle_03_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_romancandle_03","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Northern Star" -- You know nothing , Jon Snow.
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Roman Candles"

ENT.Model                            =  "models/models/gf2/rogue_cheney/romancandles/romancandle_02.mdl"                      

ENT.Mass                             =  50
ENT.GBOWNER                          =  nil           

sound.Add( {
	name = "fountain_04_fairyglitter",
	channel = CHAN_STATIC,
	volume = 1.0,
	level = 80,
	pitch = { 100, 100 },
	sound = "garrys_fireworks_2/fireworks/fountains/fountain_04_fairyglitter.mp3"
} )  

function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end


function ENT:Initialize()

	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		
		if (phys:IsValid()) then
			phys:SetMass(self.Mass)
			phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		self.IsEmitting = false
		
		self.BurningTime = 0
		
		self:Setup_Skins()
		if !(WireAddon == nil) then self.Inputs   = Wire_CreateInputs(self, { "Ignite" }) end

	
	end
end

function ENT:StartEmitting()
	if !(SERVER) or self.IsEmitting==true then return end
	self.IsEmitting=true
	self:SetSkin(self:GetBurnedSkin())
	
	for i=1,5 do
		timer.Simple(i/8, function()
			if !self:IsValid() then return end
			ParticleEffect( "gf2_romancandle_03_particle_blue", self:GetAttachment(1).Pos+(self:GetUp()*10),self:GetAngles(), nil )
			ParticleEffect( "gf2_romancandle_muzzle_explosion", self:GetAttachment(1).Pos,self:GetAngles(), nil )

			
			self:EmitSound("garrys_fireworks_2/fireworks/romancandles/muzzle.mp3")
		end)
	end

end

function ENT:GetBurnedSkin()
	local table_ent = { ["gf2_romancandle_01"] = 0,
						["gf2_romancandle_02"] = 2,
						["gf2_romancandle_03"] = 0
						}
	return table_ent[self:GetClass()]+1
end

function ENT:Setup_Skins()
	local table_ent = { ["gf2_romancandle_01"] = 0,
						["gf2_romancandle_02"] = 2,
						["gf2_romancandle_03"] = 0
						}
	self:SetSkin(table_ent[self:GetClass()])
end


if ( CLIENT ) then
	
	function ENT:Draw()
		self:DrawModel()
	
		if !(WireAddon == nil) then Wire_Render(self.Entity) end
	end
end


function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end
	 if (iname == "Ignite") then
         if (value >= 1) then
			if self.IsEmitting==false then 
				if self.IsEmitting==false && self.Armed==false then
					self:EmitSound("npc/roller/mine/rmine_blip3.wav")
					self.Armed=true
				end
				timer.Simple(1, function()
					if !self:IsValid() then return end
					self:StartEmitting() 
				end)
			end
		 end
	 end
		 
end 

function ENT:Think()

	if (SERVER) then
		if !self:IsValid() then return end
		if self.IsBurning==true then
			self.BurningTime=self.BurningTime + engine.TickInterval()/0.1
			
		end
		
		if self.BurningTime > 65 then
			self:StopParticles()
			self:SetNWBool("IsBurning", false)
			self.IsBurning=false
			self.HasBurned=true
		end
			
		
	end
end

function ENT:OnRemove()
	if (SERVER) then
		self:StopSound("fountain_04_fairyglitter")
		self:StopParticles()
	end
end

function ENT:Explode()
     if !self.Exploded then return end
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
     if self.Exploded then return end
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:Arm()
end	 

function ENT:Use( activator, caller )
	activator:PickupObject(self)
	if not activator:KeyDown(IN_WALK) then return end

	if activator:IsValid() && self.IsEmitting==false then 

		if self.IsEmitting==false && self.Armed==false then
			self:EmitSound("npc/roller/mine/rmine_blip3.wav")
			self.Armed=true
		end
		timer.Simple(1, function()
			if !self:IsValid() then return end
			self:StartEmitting() 
		end)
	end
end

