-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_battery_m_01_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_battery_m_01","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Wayward Palm" -- secretly pines :)
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Batteries"

ENT.Model                            =  "models/models/gf2/rogue_cheney/batteries/battery_mine_01.mdl"                      
ENT.Effect                           =  ""
ENT.EffectAir                        =  ""      
ENT.EffectWater                      =  "water_small"
ENT.ExplosionSound                   =  "garrys_fireworks_2/fireworks/battery/mine_wayward_01.mp3"
ENT.ArmSound                         =  "physics/wood/wood_box_impact_bullet1.wav"            
ENT.ActivationSound                  =  "physics/wood/wood_box_impact_hard1.wav"     

ENT.Timed                            =  false
                   
                                 
ENT.MaxDelay                         =  0                                 
ENT.TraceLength                      =  500
ENT.ImpactSpeed                      =  9000
ENT.Mass                             =  150
ENT.ArmDelay                         =  1
ENT.Timer                            =  0


ENT.GBOWNER                          =  nil             

	

function ENT:Start_Launching()
	ParticleEffectAttach("gf2_battery_mine_01_main", PATTACH_POINT_FOLLOW, self, self:LookupAttachment("attachment_fountain"))
	-- Fountain effect = gf2_battery_mine_01_main
	self.HasLaunched=true
	
	timer.Simple(6, function()
		if !self:IsValid() then return end
		for i=1, 8 do
			timer.Simple(i/16, function()
				ParticleEffect( "gf2_battery_shot_effect", self:GetAttachment(i).Pos,self:GetAngles(), nil )
				self:EmitSound("garrys_fireworks_2/fireworks/battery/battery_shot.wav", 100, math.random(70,120))
			end)
		end
		timer.Simple(0.1, function()
			ParticleEffect( "gf2_battery_mine_01_z_particle_01_group", self:GetAttachment(2).Pos,self:GetAngles(), nil )
		end)
		self:Explode_Sound()

		
	end)
	
	
end


function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end


function ENT:Initialize()
	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		if (phys:IsValid()) then
		phys:SetMass(self.Mass)
		phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		self.HasLaunched = true
		self:SetBodygroup(1, 1)
		if !(WireAddon == nil) then self.Inputs   = Wire_CreateInputs(self, { "Ignite"}) end
	end
end


if ( CLIENT ) then
	
	function ENT:Draw()
		self:DrawModel()
		if !(WireAddon == nil) then Wire_Render(self.Entity) end
	end
end

function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end
	 if (iname == "Ignite") then
         if (value >= 1) then
             if (!self.Exploded and !self.Armed and !self.Arming) then
			     self:EmitSound(self.ActivationSound)
                 self:Arm()
             end 
         end
     end		 
end 


function ENT:Explode()
     if !self.Exploded then return end
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
     if self.Exploded then return end
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:LaunchStarted()
	return self.HasLaunched
end
function ENT:Arm()
	if(!self:IsValid()) then return end
	if(self.Exploded) then return end
	if(self.Armed) then return end
	self:EmitSound(self.ArmSound)
	self.Armed=true
	 
	
	timer.Simple(1, function()
		if !self:IsValid() && !self:LaunchStarted() then return end 
		

		self:Start_Launching()
		self:SetBodygroup(1, 0)
	end)

end	 

if (CLIENT) then
	function ENT:Draw()
		self:DrawModel()
		return true
	end
end

