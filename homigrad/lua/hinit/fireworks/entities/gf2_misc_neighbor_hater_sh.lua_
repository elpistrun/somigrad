-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_misc_neighbor_hater_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_misc_neighbor_hater","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Neighbor Hater"
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Misc"

ENT.Model                            =  "models/models/gf2/rogue_cheney/misc/neighborhater.mdl"                      

ENT.Mass                             =  50

ENT.GBOWNER                          =  nil             

function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end


function ENT:Initialize()
	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		
		if (phys:IsValid()) then
			phys:SetMass(self.Mass)
			phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		self:SetSkin(0)

		self.Time = 0
		
		--ParticleEffectAttach( "gf2_misc_neighbor_hater_main", PATTACH_POINT_FOLLOW, self, self:LookupAttachment("attach_nozzle_01") )
		--ParticleEffectAttach( "gf2_misc_neighbor_hater_main", PATTACH_POINT_FOLLOW, self, self:LookupAttachment("attach_nozzle_02") )
	end
end




if ( CLIENT ) then
	
	function ENT:Draw()
		self:DrawModel()
	
		if !(WireAddon == nil) then Wire_Render(self.Entity) end
	end
end

function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end 
end 

function ENT:Think()
	
	if (SERVER) then
		if !self:IsValid() then return end
		if (self.IsIgnited) then self.Time = self.Time + engine.TickInterval() end
		self:Sequential()
		self:NextThink( CurTime()+0.01 )
		return true
	end
end

function ENT:Sequential()
	local phys = self:GetPhysicsObject()
	
	if self.Time >=0.1 and self.Time <=2.5 then
		phys:AddAngleVelocity(Vector(0,0,255))	
	elseif self.Time >= 1.5 and self.Time <= 3.8 then
		if self.PlayedParticles==nil then ParticleEffectAttach( "gf2_misc_neighbor_hater_glow_blue", PATTACH_POINT_FOLLOW, self, 0) self.PlayedParticles=true end
		phys:AddVelocity(self:GetUp()*30)
	elseif self.Time >= 4.5 then self.Exploded=true self:Explode() end
end

function ENT:Explode()
    if !self.Exploded then return end
	ParticleEffect("gf2_misc_neighbor_hater_main_explosion", self:GetPos(), Angle(0,0,0), nil )
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
     if self.Exploded then return end
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:Arm()
	self.IsIgnited = true
	if self.PlayedSound==nil then ParticleEffectAttach( "gf2_misc_neighbor_hater_main", PATTACH_POINT_FOLLOW, self, self:LookupAttachment("attach_nozzle_01") ) ParticleEffectAttach( "gf2_misc_neighbor_hater_main", PATTACH_POINT_FOLLOW, self, self:LookupAttachment("attach_nozzle_02") )self:EmitSound("garrys_fireworks_2/fireworks/misc/neighborhater.wav", 100, 100) self.PlayedSound=true end


end	 

ENT.DelayUse = 1

