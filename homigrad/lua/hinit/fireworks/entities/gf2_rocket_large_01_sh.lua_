-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_rocket_large_01_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_rocket_large_01","gf2_base_rocket")
if not ENT then return end

ENT.Spawnable		            	 =  true         
ENT.AdminSpawnable		             =  false

ENT.PrintName		                 =  "Night Stars: Lrg Rocket"
ENT.Author			                 =  "Rogue"
ENT.Contact			                 =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Large Rockets"

ENT.Model                            =  "models/models/gf2/rogue_cheney/rockets/big/rocket_01.mdl"
ENT.RocketTrail                      =  "gf2_firework_trail_main"
ENT.RocketBurnoutTrail               =  "firework_burnout"
ENT.Effect                           =  "gf2_rocket_large_explosion_01"

ENT.ExplosionSound                   =  "garrys_fireworks_2/fireworks/explosions/fw_large_explosion.wav"         
ENT.StartSound                       =  "garrys_fireworks_2/fireworks/launch/rocket_launch_01.wav"                        
ENT.ArmSound                         =  "npc/roller/mine/rmine_blip3.wav"            
ENT.ActivationSound                  =  "buttons/button14.wav"  
ENT.EngineSound                      =  "gf2_firework_engineloop"  
ENT.SmartLaunch                      =  false
ENT.Timed                            =  false 

ENT.ExplosionRadius                  =  800                                  
ENT.MaxIgnitionTime                  =  0           
ENT.Life                             =  20            
ENT.MaxDelay                         =  0           
ENT.TraceLength                      =  100             
ENT.Mass                             =  100
ENT.EnginePower                      =  50
ENT.FuelBurnoutTime                  =  1     
ENT.IgnitionDelay                    =  0           
ENT.ArmDelay                         =  0.1                      
ENT.ForceOrientation                 =  "UP"
ENT.Timer                            =  0
ENT.ExplodeDelay                     =  4
ENT.GBOWNER                          =  nil
ENT.SkinNumber                       =  0


function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end

function ENT:GlitterRain()
	for i=0,math.random(6,10) do
		timer.Simple((i/10)+math.random(0.05, 0.2), function()
			if !self:IsValid() then return end
			local sparky = ents.Create("prop_physics")
			sparky:SetPos(self:GetPos())
			sparky:SetModel("models/props_junk/PopCan01a.mdl")
			sparky:Spawn()
			sparky:Activate()
			sparky:SetNoDraw(false)
			sparky:SetCollisionGroup( COLLISION_GROUP_IN_VEHICLE )
			sparky:GetPhysicsObject():AddVelocity(Vector(math.random(-500, 500), math.random(-500,500),0))
			for i=1,3 do 
				timer.Simple(i, function()
				if !sparky:IsValid() then return end
					sparky:GetPhysicsObject():AddVelocity(Vector(0, 0,300))
				end)
			end
			
			ParticleEffectAttach(table.Random({"gf2_firework_idle_white_trail_2","gf2_firework_idle_golden_trail_2"}),PATTACH_ABSORIGIN_FOLLOW,sparky,1)
			ParticleEffectAttach(table.Random({"gf2_firework_idle_glow_blue","gf2_firework_idle_glow_white"}),PATTACH_ABSORIGIN_FOLLOW,sparky,1)
			timer.Simple(math.random(2,3), function() 
				if !sparky:IsValid() then return end
				sparky:Remove()
			end)
		end)
	end
end


function ENT:Launch()
	if(self.Exploded) then return end
	if(self.Burned) then return end
	if(self.Fired) then return end

	local phys = self:GetPhysicsObject()
	if !phys:IsValid() then return end

	self.Fired = true
	if(self.SmartLaunch) then
		constraint.RemoveAll(self)
	end
	timer.Simple(self.ExplodeDelay, function()
		if !self:IsValid() then return end
		self.Exploded=true
		self:Explode()
	end)
	timer.Simple(0.01,function()
		if not self:IsValid() then return end
		if(phys:IsValid()) then
			phys:Wake()
			phys:EnableMotion(true)
			self.Ignition = true
			self:EmitSound(self.StartSound, 100, 100)
			ParticleEffectAttach(self.RocketTrail,PATTACH_ABSORIGIN_FOLLOW,self,1)
			timer.Simple(0.4, function()
				if !self:IsValid() then return end
				self:EmitSound(self.EngineSound, 100, 100)
			end)
			timer.Simple(1, function()
				if !self:IsValid() then return end
				self.Armed    = true	
			end)
		end
	end) 
	timer.Simple(self.FuelBurnoutTime, function()
		if !self:IsValid() then return end
		self.Burnt=true
		self:StopParticles()
		self:StopSound(self.EngineSound)
		ParticleEffectAttach("gf2_firework_idle_white_trail",PATTACH_ABSORIGIN_FOLLOW,self,1)
	end)
	timer.Simple(2, function()
		if !self:IsValid() then return end
		self:GlitterRain()
	end)
end












