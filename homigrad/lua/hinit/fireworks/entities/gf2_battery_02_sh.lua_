-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_battery_02_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_battery_02","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Stairways to Heaven"
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Batteries"

ENT.Model                            =  "models/models/gf2/rogue_cheney/batteries/battery_02.mdl"                      
ENT.Effect                           =  ""
ENT.EffectAir                        =  ""      
ENT.EffectWater                      =  "water_small"
ENT.ExplosionSound                   =  "physics/wood/wood_crate_break1.wav"
ENT.ArmSound                         =  "physics/wood/wood_box_impact_bullet1.wav"            
ENT.ActivationSound                  =  "physics/wood/wood_box_impact_hard1.wav"     

ENT.Timed                            =  false
ENT.RandomAngles                     =  false         
                  
ENT.MaxDelay                         =  0                                 
ENT.TraceLength                      =  500
ENT.ImpactSpeed                      =  9000
ENT.Mass                             =  150
ENT.ArmDelay                         =  1
ENT.Timer                            =  0


ENT.GBOWNER                          =  nil   
          
function ENT:CreatePositions()

	local pos_table = {}
	for x=1,2 do
		for y=1,7 do

			local pos = (self:GetPos()+self:GetUp()*(-3+(math.sin(y/2.6)*12))+self:GetRight()*(12.5-(8.2*x))+self:GetForward()*(53.2-(7*y)))
			table.insert(pos_table, pos)
		end
	end

	return pos_table
end
	

function ENT:Start_Launching()
	local angles = {45, 75, 85, 90, 95, 105, 135, 45, 75, 85, 90, 95, 105, 135}
	local pos_tbl = self:CreatePositions()
	local timer_mod = 0
	for k, v in pairs(pos_tbl) do
		if k >=8 then timer_mod = 0.5 end
		timer.Simple(k/14+timer_mod, function()
			if !self:IsValid() then return end
			local pos_tbl = self:CreatePositions()
			local v = pos_tbl[k]
			
			if k <=7 then 
				v = pos_tbl[8-k]
				k = 8 - k
			end
				
			
			local vel_x, vel_y =  math.cos(angles[k]*(math.pi/180))*5000 , math.sin(angles[k]*(math.pi/180))*5000
			self:EmitSound("garrys_fireworks_2/fireworks/battery/battery_shot.wav", 100, math.random(70,120))
			
			local sparky = ents.Create("gf2_battery_pellet")
			sparky:SetPos(v)
			sparky:Spawn()
			sparky.Attacker = self.Attacker
			sparky:Activate()
			sparky.Info = {["Effect"]         = {"",""},
						  ["ExplosionSound"] = {"", ""},
						  ["Trail"]  = table.Random({"gf2_battery_02_sparkles_main"}),
						  ["ExplosionDelay"] = math.random(1,1.25),
						  ["MatchSoundwithEffect"] = true,
						  ["Effect_Sound"]         = {[""] = ""
						  }
						  }
						  

			sparky:GetPhysicsObject():AddVelocity(vel_y*self:GetUp()+vel_x*self:GetForward()+Vector(math.random(-550, 550), math.random(-550,550),0))
			sparky:SetCollisionGroup(COLLISION_GROUP_WORLD)
			

			

			
			ParticleEffect( "gf2_battery_shot_effect", v, Angle(90-angles[k],self:GetAngles().y,self:GetAngles().z), self )
		end)
	end
end


function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()

     return ent
end


function ENT:Initialize()
	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		if (phys:IsValid()) then
		phys:SetMass(self.Mass)
		phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		
		self:SetSkin(0)
		if !(WireAddon == nil) then self.Inputs   = Wire_CreateInputs(self, { "Ignite" }) end
	end
end


function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end
	 if (iname == "Ignite") then
         if (value >= 1) then
             if (!self.Exploded and !self.Armed and !self.Arming) then
			     self:EmitSound(self.ActivationSound)
                 self:Arm()
             end 
         end
     end		 
end 

function ENT:Explode()
     if !self.Exploded then return end
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
     if self.Exploded then return end
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:Arm()
	if(!self:IsValid()) then return end
	if(self.Exploded) then return end
	if(self.Armed) then return end
	self:EmitSound(self.ArmSound)
	self.Armed=true
	 
	
	timer.Simple(1, function()
		if !self:IsValid() then return end 

		if !self:IsValid() then return end 
		self.HasIgnited = true
		self.HasCalledLaunching = false
		self:Start_Launching()
		self:SetSkin(1)
	end)

end	 



if (CLIENT) then
	function ENT:Draw()

		self:DrawModel()
		if !(WireAddon == nil) then Wire_Render(self.Entity) end
		return true
	end
end
