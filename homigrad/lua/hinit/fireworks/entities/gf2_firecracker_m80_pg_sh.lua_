-- "addons\\homigrad\\lua\\hinit\\fireworks\\entities\\gf2_firecracker_m80_pg_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("gf2_firecracker_m80_pg","gf2_base_adv")
if not ENT then return end

ENT.Spawnable		= true
ENT.AdminOnly		= false

ENT.PrintName		                 =  "Peter Griffins Bunker Buster Mega Ultra Super"
ENT.Author			                 =  "Rogue Cheney"
ENT.Contact		                     =  "baldursgate3@gmail.com"
ENT.Category                         =  "G-Works 2 - Firecrackers"

ENT.Model                            =  "models/models/gf2/rogue_cheney/firecrackers/megaultrasuper.mdl"                      
ENT.Effect                           =  ""
ENT.EffectAir                        =  ""      
ENT.EffectWater                      =  "water_small"
ENT.ExplosionSound                   =  nil


ENT.ArmSound                         =  "physics/wood/wood_box_impact_bullet1.wav"            
ENT.ActivationSound                  =  "physics/wood/wood_box_impact_hard1.wav"     

ENT.ShouldUnweld                     =  false
ENT.ShouldIgnite                     =  false
ENT.ShouldExplodeOnImpact            =  true
ENT.Flamable                         =  false    
ENT.UseRandomSounds                  =  false
ENT.UseRandomModels                  =  false
ENT.Timed                            =  false
ENT.RandomAngles                     =  false         -- If this is false, the bomblets will spawn facing the general bomb direction.

ENT.ExplosionDamage                  =  100            
ENT.PhysForce                        =  100           
ENT.ExplosionRadius                  =  25          
ENT.SpecialRadius                    =  2                   
ENT.Life                             =  25                                 
ENT.MaxDelay                         =  0                                 
ENT.TraceLength                      =  500
ENT.ImpactSpeed                      =  9000
ENT.Mass                             =  150
ENT.ArmDelay                         =  1
ENT.Timer                            =  0


ENT.GBOWNER                          =  nil             

function ENT:SpawnFunction( ply, tr )
     if ( !tr.Hit ) then return end
	 self.GBOWNER = ply
     local ent = ents.Create( self.ClassName )
	 ent:SetPhysicsAttacker(ply)
     ent:SetPos( tr.HitPos + tr.HitNormal * 16 ) 
     ent:Spawn()
     ent:Activate()
     return ent
end


function Ragdoll(player, ShouldRagdoll)
	
	if (ShouldRagdoll) && player.IsRagdolled!=true && player:IsValid() then
		timer.Simple(math.random(50,100)/100, function()
			if player:IsValid() and player.Ragdoll:IsValid() then 
			player:EmitSound("garrys_fireworks_2/fireworks/firecrackers/pgbbmsu_wtf.wav", 80, 100)
			end
		end)
		local weapons = player:GetWeapons()
		
		
		
		player.IsRagdolled = true
		
		player:DrawViewModel( false )
		player:StripWeapons()

		ragdoll = ents.Create( "prop_ragdoll" )
		ragdoll:SetModel( player:GetModel() )
		ragdoll:SetPos( player:GetPos() )
		ragdoll:SetAngles( player:GetAngles() )
		ragdoll:Spawn()
		ragdoll:Activate()

		
		player.Ragdoll = ragdoll
		player:Spectate( OBS_MODE_CHASE )
		player:SpectateEntity( ragdoll )
		player:SetParent( ragdoll )

		ParticleEffectAttach("gf2_firecracker_m80_pg_bleed_hands",PATTACH_POINT_FOLLOW,ragdoll,ragdoll:LookupAttachment("anim_attachment_RH"))

		for k, v in pairs(weapons) do
			local ent = ents.Create(v:GetClass())
			ent:SetPos(player:GetPos())
			ent:Spawn()
			ent:Activate()
			
		end

		

	else

		
		
		
		
		player:Spawn()
		player:SetPos(player.Ragdoll:GetPos())
		player.IsRagdolled = false
		player:SetNoTarget( false )
		player.AllowSpawn = true
		player:SetParent()
		player:StripWeapons()
		player.Ragdoll:StopParticles()
		player.Ragdoll:Remove()
		
	end
	
end


function ENT:Initialize()
	if (SERVER) then
		self:LoadModel()
		self:PhysicsInit( SOLID_VPHYSICS )
		self:SetSolid( SOLID_VPHYSICS )
		self:SetMoveType( MOVETYPE_VPHYSICS )
		self:SetUseType( ONOFF_USE ) 
		local phys = self:GetPhysicsObject()
		local skincount = self:SkinCount()
		if (phys:IsValid()) then
		phys:SetMass(self.Mass)
		phys:Wake()
		end

		self.Armed    = false
		self.Exploded = false
		self.Used     = false
		self.Arming   = false
		
		self:EmitSound("garrys_fireworks_2/fireworks/firecrackers/pgbbmsu.wav", 80, 100)
		
		if !(WireAddon == nil) then self.Inputs   = Wire_CreateInputs(self, { "Arm", "Detonate" }) end
	end
end


if ( CLIENT ) then
	function ENT:Draw()
		self:DrawModel()
		if !(WireAddon == nil) then Wire_Render(self.Entity) end
	end
end


function ENT:Explode_Sound()

	local pos = self:GetPos()
	local ent = ents.Create("gf2_shockwave_sound_lowsh")
	ent:SetPos(pos)
	ent:Spawn()
	ent:Activate()
	ent.MAX_RANGE = 50000
	ent.SHOCKWAVE_INCREMENT = 100
	ent.SOUND = table.Random({"garrys_fireworks_2/fireworks/firecrackers/pgbbmsu_explosion.wav"})
	
	ent.ShakeSettings = { ["ShakeTime"] = 0.1,
						["SoundAmp"] = 5,
						["SoundFreq"] = 5
						}
						
						
						  
end


function ENT:TriggerInput(iname, value)
     if (!self:IsValid()) then return end
	 if (iname == "Detonate") then
         if (value >= 1) then
		     if (!self.Exploded and self.Armed) then
			     timer.Simple(math.Rand(0,self.MaxDelay),function()
				     if !self:IsValid() then return end
	                 self.Exploded = true
			         self:Explode()
				 end)
		     end
		 end
	 end
	 if (iname == "Arm") then
         if (value >= 1) then
             if (!self.Exploded and !self.Armed and !self.Arming) then
			     self:EmitSound(self.ActivationSound)
                 self:Arm()
             end 
         end
     end		 
end 



function ENT:Explode()
    if !self.Exploded then return end

	ParticleEffect("gf2_firecracker_m80_main", self:GetPos(), Angle(0,0,0), nil)
	self:Explode_Sound()
	

	for k, v in pairs(ents.FindInSphere(self:GetPos(), 100)) do
		if v:IsValid() and v.Ragdolled!=true  and v:IsPlayer() then
			
			Ragdoll(v, true)
			local ply = v 
			timer.Simple(math.random(400,500)/100, function() 
				if !ply:IsValid() then return end 
				Ragdoll(ply, false) 
				
			end) 
			
		end
		
		
	end
	
	for k, v in pairs(ents.FindInSphere(self:GetPos(), 100)) do
		if v:GetPhysicsObject():IsValid() then 
			phys = v:GetPhysicsObject()
			local F_dir = nil

			
			if v:GetClass()=="prop_ragdoll" then F_dir = (v:GetPos() - self:GetPos()):GetNormal() * 50000
			else F_dir = (v:GetPos() - self:GetPos()):GetNormal() * 500
			end
			phys:AddVelocity(F_dir)
			
			
			
		end
	end
	self:Remove()
end

function ENT:OnTakeDamage(dmginfo)
end

function ENT:PhysicsCollide( data, physobj )
end

function ENT:Arm()
	if(!self:IsValid()) then return end
	if(self.Exploded) then return end
	if(self.Armed) then return end
	self:EmitSound(self.ArmSound)
	self.Armed=true
	ParticleEffectAttach("gf2_firecracker_m80_pg_ignition_glow", PATTACH_ABSORIGIN_FOLLOW,self,1)
	self:EmitSound("garrys_fireworks_2/fireworks/ignition/fuse.wav", 80, 100)
	
	
	timer.Simple(3, function()
		if !self:IsValid() then return end 
		self.Exploded=true
		self:Explode()
	end)

end	 
