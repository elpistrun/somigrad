-- "addons\\homigrad\\lua\\hgame\\tier_1\\fake\\ragdoll\\tier_0_sh.lua"
-- Retrieved by https://github.com/lewisclark/glua-steal
local ENT = oop.Reg("fake_ragdoll","lib_event",true)
if not ENT then return INCLUDE_BREAK end

FindMetaTable("Player").GetEntity = function(self)
	local ent = self:GetNWEntity("Ragdoll")
	
	return IsValid(ent) and ent or self
end

ENT:Event_Add("Construct","RagdollEntities",function(class)
	if not RagdollEntities then return end

	for ent in pairs(RagdollEntities) do
		if not IsValid(ent) then RagdollEntities[ent] = nil end

		util.tableLink(ent,class[1])
	end
end)
